# Copy this file to `.env` and fill in real values.

# Application under test
BASE_URL=

# Role: Borrower (individual) - can access Statement Analyzer + SME dashboard
BORROWER_EMAIL=
BORROWER_PASSWORD=

# Role: Credit Officer / Underwriter - can access Credit Underwriter + Portfolio dashboards
CREDIT_OFFICER_EMAIL=
CREDIT_OFFICER_PASSWORD=

# Role: Developer - can access the Credit Score API portal
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# Optional: API key for POST /api/v1/score/.
# If left empty the suite reads the token from the Developer API portal UI at runtime,
CREDIT_API_KEY=
